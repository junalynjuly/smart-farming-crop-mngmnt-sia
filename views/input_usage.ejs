<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Input Usage Management</title>
    <style>
        body { font-family: Arial, sans-serif; background: #f4f6f8; padding: 20px; }
        .container { max-width: 800px; margin: auto; background: white; padding: 20px; border-radius: 8px; }
        h1 { color: #2e7d32; text-align: center; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { padding: 12px; border: 1px solid #ddd; text-align: left; }
        th { background-color: #4caf50; color: white; }
    </style>
</head>
<body>
    <div class="container">
        <h1>Input Usage Records</h1>
        <table>
            <thead>
                <tr>
                    <th>Usage ID</th>
                    <th>Planting ID</th>
                    <th>Input ID</th>
                    <th>Quantity Used</th>
                    <th>Application Date</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                <tr><td colspan="5" style="text-align: center;">Loading...</td></tr>
            </tbody>
        </table>
    </div>

    <script>
        fetch('/api/input-usage')
            .then(res => res.json())
            .then(data => {
                const tbody = document.getElementById('tableBody');
                tbody.innerHTML = '';
                const rows = data.data || data;
                if(rows.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="5" style="text-align: center;">No input usage records found.</td></tr>';
                    return;
                }
                rows.forEach(item => {
                    tbody.innerHTML += `<tr>
                        <td>${item.usage_id || item.id || ''}</td>
                        <td>${item.planting_id || ''}</td>
                        <td>${item.input_id || ''}</td>
                        <td>${item.quantity_used || item.quantity || ''}</td>
                        <td>${item.application_date ? item.application_date.split('T')[0] : ''}</td>
                    </tr>`;
                });
            })
            .catch(err => {
                document.getElementById('tableBody').innerHTML = '<tr><td colspan="5" style="text-align: center; color: red;">Failed to load data.</td></tr>';
            });
    </script>
</body>
</html>
