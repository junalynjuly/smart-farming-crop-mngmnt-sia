<%- include('../partials/header') %>

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Add New Field</h4>
        </div>
        <div class="card-body">
            <% if (locals.error && error) { %>
                <div class="alert alert-danger"><%= error %></div>
            <% } %>

            <form action="/fields/add" method="POST">
                <div class="mb-3">
                    <label for="field_name" class="form-label">Field Name *</label>
                    <input type="text" class="form-control" id="field_name" name="field_name" required>
                </div>

                <div class="mb-3">
                    <label for="farm_id" class="form-label">Associated Farm *</label>
                    <select class="form-select" id="farm_id" name="farm_id" required>
                        <option value="" disabled selected>Select a farm...</option>
                        <% if (farms && farms.length > 0) { %>
                            <% farms.forEach(farm => { %>
                                <option value="<%= farm.farm_id %>"><%= farm.farm_name %></option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>

                <div class="mb-3">
                    <label for="area_hectares" class="form-label">Area (Hectares) *</label>
                    <input type="number" step="0.01" min="0.01" class="form-control" id="area_hectares" name="area_hectares" required>
                </div>

                <div class="mb-3">
                    <label for="soil_type" class="form-label">Soil Type</label>
                    <input type="text" class="form-control" id="soil_type" name="soil_type" placeholder="e.g., Loam, Clay, Sandy">
                </div>

                <div class="mb-3">
                    <label for="status" class="form-label">Status</label>
                    <select class="form-select" id="status" name="status">
                        <option value="Idle" selected>Idle</option>
                        <option value="Planted">Planted</option>
                        <option value="Fallow">Fallow</option>
                    </select>
                </div>

                <div class="d-flex justify-content-between">
                    <a href="/fields" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-success">Save Field</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>