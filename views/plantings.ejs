<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Plantings Management</title>
    <style>
        body { font-family: Arial, sans-serif; background: #f4f6f8; padding: 20px; }
        .container { max-width: 800px; margin: auto; background: white; padding: 20px; border-radius: 8px; }
        h1 { color: #2e7d32; text-align: center; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { padding: 12px; border: 1px solid #ddd; text-align: left; }
        th { background-color: #4caf50; color: white; }
    </style>
</head>
<body>
    <div class="container">
        <h1>Plantings Records</h1>
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Field ID</th>
                    <th>Crop ID</th>
                    <th>Planting Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                <tr><td colspan="5" style="text-align: center;">Loading...</td></tr>
            </tbody>
        </table>
    </div>

    <script>
        fetch('/api/plantings')
            .then(res => res.json())
            .then(data => {
                const tbody = document.getElementById('tableBody');
                tbody.innerHTML = '';
                const rows = data.data || data;
                rows.forEach(item => {
                    tbody.innerHTML += `<tr>
                        <td>${item.planting_id || ''}</td>
                        <td>${item.field_id || ''}</td>
                        <td>${item.crop_id || ''}</td>
                        <td>${item.planting_date ? item.planting_date.split('T')[0] : ''}</td>
                        <td>${item.status || 'Active'}</td>
                    </tr>`;
                });
            });
    </script>
</body>
</html>
