<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Weather Logs - SIA</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
    <div class="container my-5">
        <h2 class="mb-4 text-primary">Weather Monitoring Logs</h2>
        
        <!-- Weather Log Form -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Record Environmental & Weather Data</h5>
            </div>
            <div class="card-body">
                <form action="/weather-logs/add" method="POST">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Temperature (°C)</label>
                            <input type="number" step="0.1" name="temperature_c" class="form-control" placeholder="e.g., 29.5" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Humidity (%)</label>
                            <input type="number" step="0.1" name="humidity_pct" class="form-control" placeholder="e.g., 75" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Rainfall (mm)</label>
                            <input type="number" step="0.1" name="rainfall_mm" class="form-control" placeholder="e.g., 12.0" required>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Condition Summary</label>
                            <input type="text" name="condition_summary" class="form-control" placeholder="e.g., Sunny, Light Showers, Thunderstorm">
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary">Save Weather Log</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Logs Table -->
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Recent Weather Logs</h5>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Temperature</th>
                            <th>Humidity</th>
                            <th>Rainfall</th>
                            <th>Condition</th>
                            <th>Logged At</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (typeof logs !== 'undefined' && logs.length > 0) { %>
                            <% logs.forEach((log, index) => { %>
                                <tr>
                                    <td><%= index + 1 %></td>
                                    <td><%= log.temperature_c %>°C</td>
                                    <td><%= log.humidity_pct %>%</td>
                                    <td><%= log.rainfall_mm %> mm</td>
                                    <td><span class="badge bg-info text-dark"><%= log.condition_summary %></span></td>
                                    <td><%= log.log_date %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="text-center py-3 text-muted">No weather logs recorded yet.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>