<!DOCTYPE html>
<html>
<head>
    <title>Weather Logs</title>
</head>
<body>
    <h1>Weather Logs</h1>

    <h2>Add New Weather Log</h2>
    <form action="/weather-logs/add" method="POST">
        <input type="number" name="field_id" placeholder="Field ID" required />
        <input type="number" step="0.1" name="temperature" placeholder="Temperature (°C)" required />
        <input type="number" step="0.1" name="humidity" placeholder="Humidity (%)" required />
        <input type="number" step="0.1" name="rainfall" placeholder="Rainfall (mm)" required />
        <input type="datetime-local" name="logged_at" required />
        <button type="submit">Add Log</button>
    </form>

    <h2>Logged Weather Data</h2>
    <table border="1">
        <tr>
            <th>ID</th>
            <th>Field ID</th>
            <th>Temp (°C)</th>
            <th>Humidity (%)</th>
            <th>Rainfall (mm)</th>
            <th>Logged At</th>
        </tr>
        <% logs.forEach(log => { %>
        <tr>
            <td><%= log.log_id %></td>
            <td><%= log.field_id %></td>
            <td><%= log.temperature %></td>
            <td><%= log.humidity %></td>
            <td><%= log.rainfall %></td>
            <td><%= log.logged_at %></td>
        </tr>
        <% }) %>
    </table>
</body>
</html>