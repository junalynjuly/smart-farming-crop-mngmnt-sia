<%- include('../partials/header') %>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>Idle Fields Report</h2>
            <p class="text-muted mb-0">Fields with no active plantings (Generated via LEFT JOIN)</p>
        </div>
        <a href="/reports" class="btn btn-outline-secondary">Back to Reports</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Field ID</th>
                            <th>Field Name</th>
                            <th>Farm Name</th>
                            <th>Area (Hectares)</th>
                            <th>Soil Type</th>
                            <th>Current Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (idleFields && idleFields.length > 0) { %>
                            <% idleFields.forEach(field => { %>
                                <tr>
                                    <td><%= field.field_id %></td>
                                    <td><strong><%= field.field_name %></strong></td>
                                    <td><%= field.farm_name %></td>
                                    <td><%= field.area_hectares %></td>
                                    <td><%= field.soil_type %></td>
                                    <td>
                                        <span class="badge bg-secondary"><%= field.status %></span>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">No idle fields found (all fields currently have active plantings).</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>