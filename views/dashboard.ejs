<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Smart Farming System Dashboard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-success mb-4">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="#">Smart Farming System</a>
        </div>
    </nav>

    <div class="container">
        <h2 class="mb-4">System Dashboard</h2>

        <div class="row">
            <!-- Pest Reports Card -->
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm h-100 border-success">
                    <div class="card-body text-center">
                        <h5 class="card-title text-success">Pest Reports & Monitoring</h5>
                        <p class="card-text text-muted">Log pest sightings, track severity levels, and review field health notes.</p>
                        <a href="/api/pest-reports" class="btn btn-success">
                    </div>
                </div>
            </div>

            <!-- Weather Logs Card -->
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm h-100 border-primary">
                    <div class="card-body text-center">
                        <h5 class="card-title text-primary">Weather Logs</h5>
                        <p class="card-text text-muted">Track rainfall, temperature readings, and environmental conditions.</p>
                        <a href="/weather" class="btn btn-primary">Open Weather Logs</a>
                    </div>
                </div>
            </div>

            <!-- System Overview Card -->
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm h-100 border-secondary">
                    <div class="card-body text-center">
                        <h5 class="card-title text-secondary">Crops & Fields</h5>
                        <p class="card-text text-muted">View field allocations, planting stages, and crop growth metrics.</p>
                        <a href="/crops" class="btn btn-secondary">View Crops</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
