<!DOCTYPE html>
<html>
<head>
    <title>Smart Farming Dashboard</title>
</head>
<body>
    <h1>Smart Farming Dashboard</h1>
    
    <nav>
        <a href="/pest-reports">Manage Pest Reports</a> | 
        <a href="/weather-logs">Manage Weather Logs</a>
    </nav>

    <h2>Pest Report Count Per Crop</h2>
    <table border="1">
        <tr>
            <th>Crop Name</th>
            <th>Total Pest Reports</th>
        </tr>
        <% pestCounts.forEach(row => { %>
        <tr>
            <td><%= row.crop_name %></td>
            <td><%= row.pest_count %></td>
        </tr>
        <% }) %>
    </table>
</body>
</html>